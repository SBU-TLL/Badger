###############################################################################
# Badger monorepo — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. The container reads these at runtime;
# nothing is baked into the image (.dockerignore excludes .env*).
#
# The 6 Credly apps (Badger/DUEBadger/Gradger/WolfPack/Buddy/SEFA) share ONE
# Credly application + one badging service account, so a single set of the
# CREDLY_* variables below configures all of them.
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Credly API credentials (REQUIRED) ---------------------------------------
# The apps call the Credly v1.1 REST API to issue badges. These were previously
# HARDCODED in credlyAPI.php (now read via getenv); supply the CURRENT/ROTATED
# values here. (See the security note at the bottom.)
CREDLY_API_DOMAIN=https://api.credly.com/v1.1
CREDLY_API_KEY=your_credly_api_key
CREDLY_API_SECRET=your_credly_api_secret
CREDLY_ACCESS_TOKEN=your_credly_access_token
CREDLY_APP_ID=your_credly_app_id            # e.g. 693

# --- Credly badging service account (REQUIRED for getToken.php) --------------
# The Stony Brook account the badge-issuing tooling authenticates as.
CREDLY_ACCOUNT_EMAIL=digitalbadging@connect.stonybrook.edu
CREDLY_ACCOUNT_PASSWORD=your_service_account_password

# --- Authentication (handled at the ingress / reverse proxy) -----------------
# Shibboleth SSO is enforced by the ingress/reverse proxy (Ansible-managed),
# NOT inside this container. The proxy supplies the Shibboleth attributes
# (mail / nickname / sn) that giveYourselfCredit.php reads from $_SERVER.

# --- Database ----------------------------------------------------------------
# NONE for the 6 Credly apps. (The ORSEE app, cbpe/, DOES use MySQL, but it is
# NOT part of this image — it deploys separately.)

###############################################################################
# SECURITY — the previously-committed Credly keys + service-account password
# remain in this repo's GIT HISTORY. They MUST be rotated in Credly and the SBU
# account, and ideally purged from history (git filter-repo / BFG). Externalizing
# to env vars stops NEW images from leaking them, but does not undo past exposure.
###############################################################################
